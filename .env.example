# Configuración de entorno
APP_ENV=development
APP_DEBUG=true
APP_NAME=Algorix
APP_TIMEZONE=America/Santiago
BASE_URL=/algorix

# Configuración de base de datos
DB_HOST=localhost
DB_NAME=algorix
DB_USER=root
DB_PASS=

# Configuración de Supabase (si se usa)
# Algorix environment example
# Supabase project URL and keys
SUPABASE_URL=
# Anon key (public, client-side reads)
SUPABASE_KEY=
# Service role key (server-side privileged writes). Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=

# Modo offline
OFFLINE_MODE=true

# Configuración de IA Educativa
AI_ENDPOINT=https://oi-server.onrender.com/chat/completions
AI_TOKEN=
AI_CUSTOMER_ID=
AI_MODEL=openrouter/claude-sonnet-4

# Otras configuraciones
LOG_LEVEL=debug